{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/ja", "destination": "/", "permanent": true },
    { "source": "/ja/:path*", "destination": "/:path*", "permanent": true }
  ]
}
